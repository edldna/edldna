# SuperGuard - .gitignore

# Variáveis de ambiente (nunca commitar!)
.env
*.env

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# Ambiente virtual
venv/
.venv/
env/
.env/

# Jupyter Notebooks
.ipynb_checkpoints/

# Pytest / Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# IDEs
.idea/
.vscode/
*.swp
*.swo

# Modelos YOLO (podem ser grandes)
*.pt
*.onnx
runs/

# Fotos de alertas (dados sensíveis)
alerts/*.jpg
alerts/*.jpeg
alerts/*.png

# Logs
logs/
*.log

# Docker
.dockerignore

# Banco de dados local
*.db
*.sqlite3

# macOS
.DS_Store

# Windows
Thumbs.db
