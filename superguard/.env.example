# ============================================================
# SuperGuard - Exemplo seguro para versionar no Git
# Copie para .env e preencha com seus dados reais.
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=superguard
POSTGRES_PASSWORD=ALTERE_AQUI
POSTGRES_DB=superguard
DATABASE_URL=postgresql+asyncpg://superguard:ALTERE_AQUI@postgres:5432/superguard

# --- JWT (Painel Web) ---
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=ALTERE_COM_CHAVE_LONGA_E_ALEATORIA
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
RESET_PASSWORD_TOKEN_EXPIRE_MINUTES=15
PUBLIC_BASE_URL=

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- Câmeras RTSP ---
# Formato JSON array para evitar problemas de parsing
CAMERA_URLS=["rtsp://usuario:senha@ip:554/cam/realmonitor?channel=1&subtype=0"]
CAMERA_NAMES=["Entrada Principal"]

# --- Loja / Detecção ---
STORE_NAME=Supermercado Exemplo
DETECTION_CONFIDENCE=0.45
DEBOUNCE_SECONDS=30
TARGET_FPS=15
DEFAULT_VIDEO_FPS=25.0

# --- Modelos ---
MODELS_DIR=/app/models
MODEL_DEFAULT_PATH=yolo11n.pt
MODEL_PERSON_PATH=yolov8n.pt
MODEL_SHOPLIFTING_PATH=superguard_shoplifting.pt
MODEL_LIVE_PATH=/app/superguard_shoplifting.pt

# --- Treino / Dataset ---
TRAIN_FRAMES_DIR=/app/train_frames
TRAIN_PIPELINE_DIR=/app/train_pipeline
TRAIN_CAPTURE_IMAGE_LIMIT=150

# --- Armazenamento ---
ALERTS_DIR=/app/alerts
ALERTS_MAX_DAYS=30
ALERTS_KEEP_LATEST=10

# --- Ambiente ---
ENVIRONMENT=development
WORKER_SECRET=ALTERE_WORKER_SECRET
INTERNAL_SERVICE_TOKEN=

# --- Streaming (MediaMTX) ---
STREAM_BACKEND=mediamtx
STREAM_PUBLISH_ENABLED=true
MEDIAMTX_HOST=mediamtx
MEDIAMTX_PUBLIC_HOST=localhost
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_HLS_PORT=8888
MEDIAMTX_WEBRTC_PORT=8889
MEDIAMTX_USE_WEBRTC=true
MEDIAMTX_PATH_TEMPLATE=cam_{camera_id}_{kind}
STREAM_DEFAULT_KIND=annotated
STREAM_FFMPEG_PRESET=veryfast
STREAM_FFMPEG_TUNE=zerolatency

# --- Fila (Celery/RabbitMQ) ---
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=rpc://

# --- Avaliador VLM (opcional) ---
GEMINI_API_KEY=
GEMINI_MODEL_CANDIDATES=gemini-2.0-flash,gemini-2.0-flash-lite,gemini-1.5-flash,gemini-1.5-flash-8b

