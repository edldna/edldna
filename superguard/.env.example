# ============================================================
# SuperGuard - Variáveis de Ambiente (copie para .env)
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=superguard
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA
POSTGRES_DB=superguard
DATABASE_URL=postgresql+asyncpg://superguard:TROQUE_ESTA_SENHA@postgres:5432/superguard

# --- JWT (Painel Web) ---
# Gere uma chave segura com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=TROQUE_ESTA_CHAVE_SECRETA
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=SEU_TOKEN_AQUI
# Chat ID do admin principal (use @userinfobot para descobrir)
TELEGRAM_ADMIN_CHAT_ID=SEU_CHAT_ID_AQUI

# --- Câmeras RTSP (separadas por vírgula) ---
# Exemplo: rtsp://usuario:senha@192.168.1.100:554/stream
CAMERA_URLS=rtsp://192.168.1.100:554/stream1,rtsp://192.168.1.101:554/stream2
CAMERA_NAMES=Entrada Principal,Caixa 01

# --- Supermercado ---
STORE_NAME=Supermercado Central

# --- Detecção ---
# Confiança mínima para acionar alerta (0.0 a 1.0)
DETECTION_CONFIDENCE=0.75
# Debounce em segundos por câmera (evita spam)
DEBOUNCE_SECONDS=30
# FPS alvo por câmera
TARGET_FPS=15

# --- Armazenamento ---
ALERTS_DIR=/app/alerts

# --- Ambiente (development ou production) ---
ENVIRONMENT=development
